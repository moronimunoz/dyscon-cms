diff --git a/docs/css/styles.css b/docs/css/styles.css
index 5cb9701..c8e8cc9 100644
--- a/docs/css/styles.css
+++ b/docs/css/styles.css
@@ -1763,4 +1763,92 @@ button {
 .error-acceso:hover {
   transform: translateY(-4px);
   box-shadow: 0 12px 28px rgba(15, 61, 78, .16);
-}
\ No newline at end of file
+}
+
+/* =========================================================
+   CORAZÓN DE FAVORITO (js/favoritos.js)
+   No favorita: contorno negro con el centro transparente · favorita: relleno rosa.
+   Va arriba a la derecha de la foto en las tarjetas, y a la izquierda
+   del botón de compartir en la ficha de la obra.
+   ========================================================= */
+.fav-btn {
+  --fav-contorno: #000;
+  --fav-rosa: #ff56d5;
+  display: grid;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  cursor: pointer;
+  /* halo blanco finito para que el contorno negro se lea también sobre fotos oscuras */
+  filter: drop-shadow(0 0 2px rgba(255, 255, 255, .95));
+  transition: transform .2s ease;
+}
+
+.fav-btn .icon {
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+  fill: none;
+  stroke: var(--fav-contorno);
+  stroke-width: 2;
+  stroke-linejoin: round;
+}
+
+.fav-btn[aria-pressed="true"] {
+  filter: drop-shadow(0 1px 3px rgba(0, 0, 0, .3));
+}
+
+.fav-btn[aria-pressed="true"] .icon {
+  fill: var(--fav-rosa);
+  stroke: none;
+}
+
+.fav-btn:hover {
+  transform: scale(1.12);
+}
+
+.fav-btn:active {
+  transform: scale(.94);
+}
+
+.fav-btn:focus-visible {
+  outline: 3px solid var(--teal-500);
+  outline-offset: 3px;
+  border-radius: 50%;
+}
+
+/* En la tarjeta: arriba a la derecha de la foto (fuera del enlace, así no abre la obra) */
+.obra-card {
+  position: relative;
+}
+
+.fav-btn--tarjeta {
+  position: absolute;
+  top: .6rem;
+  right: .6rem;
+  z-index: 3;
+  width: 40px;
+  height: 40px;
+  padding: 8px 7px;
+}
+
+/* En la ficha: a la izquierda del botón de compartir (usa las mismas medidas que .obra-compartir-boton) */
+.fav-btn--ficha {
+  position: absolute;
+  right: 56px;
+  bottom: calc(var(--sube) + var(--aire));
+  width: 44px;
+  height: 44px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .fav-btn {
+    transition: none;
+  }
+
+  .fav-btn:hover,
+  .fav-btn:active {
+    transform: none;
+  }
+}
