diff --git a/docs/css/destacado.css b/docs/css/destacado.css
new file mode 100644
index 0000000..6e4cbe5
--- /dev/null
+++ b/docs/css/destacado.css
@@ -0,0 +1,120 @@
+/* =========================================================
+   PROYECTO DESTACADO (banner con enlace a NODO)
+   ========================================================= */
+.destacado {
+  padding: 3.5rem 0;
+  background: var(--blanco);
+}
+
+.destacado-contenedor {
+  max-width: 1920px;
+  margin: 0 auto;
+  padding: 0 2%;
+}
+
+.destacado .titulo {
+  font-size: 2.1rem;
+  margin-bottom: 1.8rem;
+}
+
+.destacado-banner {
+  position: relative;
+  display: block;
+  aspect-ratio: 4 / 1;
+  overflow: hidden;
+  border-radius: 18px;
+  background: var(--teal-900);
+}
+
+.destacado-banner img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: 50% 50%;
+  transition: transform .6s ease;
+}
+
+/* Degradado suave abajo para que la flecha blanca siempre se lea */
+.destacado-banner::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(to top, rgba(0, 0, 0, .35), rgba(0, 0, 0, 0) 45%);
+  pointer-events: none;
+}
+
+.destacado-flecha {
+  position: absolute;
+  left: 50%;
+  bottom: 7%;
+  z-index: 1;
+  display: grid;
+  place-items: center;
+  color: #fff;
+  transform: translateX(-50%);
+  transition: transform .3s ease;
+  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .45));
+}
+
+.destacado-flecha .icon {
+  width: 64px;
+  height: 64px;
+  stroke-width: 2.4;
+}
+
+.destacado-banner:hover img,
+.destacado-banner:focus-visible img {
+  transform: scale(1.03);
+}
+
+.destacado-banner:hover .destacado-flecha,
+.destacado-banner:focus-visible .destacado-flecha {
+  transform: translateX(calc(-50% + 10px));
+}
+
+.destacado-banner:focus-visible {
+  outline: 3px solid var(--teal-500);
+  outline-offset: 4px;
+}
+
+@media (max-width: 1100px) {
+  .destacado-banner {
+    aspect-ratio: 3 / 1;
+  }
+}
+
+@media (max-width: 760px) {
+  .destacado {
+    padding: 2.5rem 0;
+  }
+
+  .destacado-contenedor {
+    padding: 0 5%;
+  }
+
+  .destacado .titulo {
+    font-size: 1.6rem;
+  }
+
+  .destacado-banner {
+    aspect-ratio: 16 / 10;
+    border-radius: 14px;
+  }
+
+  .destacado-flecha .icon {
+    width: 48px;
+    height: 48px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+
+  .destacado-banner img,
+  .destacado-flecha {
+    transition: none;
+  }
+
+  .destacado-banner:hover img {
+    transform: none;
+  }
+}
