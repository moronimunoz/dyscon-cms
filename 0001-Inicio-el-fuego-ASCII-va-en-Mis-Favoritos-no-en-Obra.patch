From 0e42ff444122834916114208de059181dbba6840 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 13:18:59 +0000
Subject: [PATCH] Inicio: el fuego ASCII va en Mis Favoritos (no en Obras
 destacadas); fuego-seccion.js respeta data-selector

---
 docs/css/inicio.css      | 15 +++++++--------
 docs/index.html          |  4 ++--
 docs/js/fuego-seccion.js |  3 ++-
 3 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/docs/css/inicio.css b/docs/css/inicio.css
index b5560b6..cc29bce 100644
--- a/docs/css/inicio.css
+++ b/docs/css/inicio.css
@@ -110,25 +110,24 @@ main section[hidden] {
   }
 }
 
-/* ---------- Obras destacadas con fuego de fondo (js/fuego-seccion.js) ---------- */
-#obras .titulo,
-#obras .link-flecha {
+/* ---------- Mis Favoritos con fuego de fondo (js/fuego-seccion.js) ---------- */
+#favoritos-inicio .titulo,
+#favoritos-inicio .link-flecha {
   color: #fff;
 }
 
-#obras .titulo::before {
+#favoritos-inicio .titulo::before {
   background: #ff9a3c;
 }
 
-#obras .obra-card {
+#favoritos-inicio .obra-card {
   box-shadow: 0 10px 30px rgba(0, 0, 0, .35);
 }
 
-
 /* ---------- Mis Favoritos (js/favoritos-inicio.js) ---------- */
-/* Se muestra solo si hay favoritas (si no, la oculta el atributo hidden, ver más arriba). Hasta 4 tarjetas en una fila. */
+/* Hasta 4 tarjetas en una fila. */
 .obras--favoritos {
-  padding-bottom: 1rem;
+  padding-bottom: 4rem;   /* mismo aire que arriba: la sección tiene fondo propio */
 }
 
 @media (min-width: 1101px) {
diff --git a/docs/index.html b/docs/index.html
index 19118ef..03f0162 100644
--- a/docs/index.html
+++ b/docs/index.html
@@ -18,7 +18,7 @@
   <link rel="preload" href="fonts/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
   <link rel="preload" href="fonts/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
   <link rel="stylesheet" href="css/styles.css?v=5">
-  <link rel="stylesheet" href="css/inicio.css?v=2">
+  <link rel="stylesheet" href="css/inicio.css?v=3">
 </head>
 
 <body>
@@ -377,7 +377,7 @@
   <script src="js/favoritos-inicio.js?v=1"></script>
   <script src="js/novedades-data.js"></script>
   <script src="js/novedades-lista.js"></script>
-  <script src="js/fuego-seccion.js?v=1" data-selector="#obras"></script>
+  <script src="js/fuego-seccion.js?v=2" data-selector="#favoritos-inicio"></script>
   <script src="js/main.js?v=5"></script>
   <script src="js/analitica.js" defer></script>
 </body>
diff --git a/docs/js/fuego-seccion.js b/docs/js/fuego-seccion.js
index 47454e9..9d60840 100644
--- a/docs/js/fuego-seccion.js
+++ b/docs/js/fuego-seccion.js
@@ -14,6 +14,7 @@
    Aspecto: edita los valores del bloque CFG más abajo.
    ===================================================================== */
 (function () {
+  const scriptTag = document.currentScript;   // hay que tomarlo ahora: dentro de arrancar() (DOMContentLoaded) ya es null
   function arrancar() {
 (() => {
   // ---------- AJUSTES ----------
@@ -89,7 +90,7 @@
     };
   }
 
-  const tag = document.currentScript;
+  const tag = scriptTag;
   const host = document.querySelector((tag && tag.dataset.selector) || "#obras");
   if (!host) { console.warn("fuego-seccion: no encontré el contenedor", tag && tag.dataset.selector); return; }
   const cv = document.createElement("canvas"), ctx = cv.getContext("2d");
-- 
2.43.0

